<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TagBites</RootNamespace>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!-- Usings -->
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Compatible Npgsql -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug-CompatibleNpgsql'">
    <CompatibleNpgsqlPath Condition="'$(CompatibleNpgsqlPath)' == ''">$(TagBitesRepositoryRoot)..\..\Vendo.CompatibleNpgsql\src\Npgsql\bin\Debug\net8.0\Npgsql.dll</CompatibleNpgsqlPath>
  </PropertyGroup>

  <Target Name="SwapNpgsql" AfterTargets="Build" Condition="'$(CompatibleNpgsqlPath)' != ''">
    <Error Condition="!Exists('$(CompatibleNpgsqlPath)')" Text="Compatible Npgsql not found at '$(CompatibleNpgsqlPath)'. Build Vendo.CompatibleNpgsql first, or set CompatibleNpgsqlPath." />
    <Copy SourceFiles="$(CompatibleNpgsqlPath)" DestinationFolder="$(OutDir)" />
    <Message Importance="high" Text="Npgsql.dll replaced with $(CompatibleNpgsqlPath)" />
  </Target>

  <!-- Connection settings -->
  <ItemGroup>
    <None Update="connection.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="connection.default.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- References -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.4.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql" Version="8.0.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TagBites.DB\TagBites.DB.csproj" />
    <ProjectReference Include="..\..\src\TagBites.DB.Postgres\TagBites.DB.Postgres.csproj" />
    <ProjectReference Include="..\..\src\TagBites.DB.Npgsql\TagBites.DB.Npgsql.csproj" />
    <ProjectReference Include="..\..\src\TagBites.DB.Sqlite\TagBites.DB.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\TagBites.DB.SqlServer\TagBites.DB.SqlServer.csproj" />
  </ItemGroup>

</Project>
