<Project Sdk="Microsoft.NET.Sdk">

  <!-- Targets -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net462;net7.0;net8.0</TargetFrameworks>
    <RootNamespace>TagBites.DB.Npgsql</RootNamespace>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!-- Build -->
  <PropertyGroup>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <!-- Warnings -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <!-- Package info -->
  <PropertyGroup>
    <Description>Npgsql driver for TagBites.DB.Postgres. Connects the PostgreSQL support in TagBites.DB to the Npgsql ADO.NET provider.</Description>
    <PackageTags>database; postgresql; postgres; npgsql; sql; data-access</PackageTags>
    <PackageProjectUrl>https://tagbites.com/db/</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <!-- References -->
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="8.0.2">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" Condition=" '$(Configuration)' == 'Debug' " />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TagBites.DB.Postgres\TagBites.DB.Postgres.csproj" />
  </ItemGroup>

</Project>
