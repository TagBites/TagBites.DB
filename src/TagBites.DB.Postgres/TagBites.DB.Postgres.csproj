<Project Sdk="Microsoft.NET.Sdk">

  <!-- Targets -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>TagBites.DB.Postgres</RootNamespace>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!-- Build -->
  <PropertyGroup>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <!-- Warnings -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <!-- Package info -->
  <PropertyGroup>
    <Description>PostgreSQL support for TagBites.DB, with cursors, notifications and array types. Needs a driver package such as TagBites.DB.Npgsql.</Description>
    <PackageTags>database; postgresql; postgres; sql; data-access; cursor; notify</PackageTags>
    <PackageProjectUrl>https://tagbites.com/db/</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <!-- References -->
  <ItemGroup>
    <ProjectReference Include="..\TagBites.DB\TagBites.DB.csproj" />
  </ItemGroup>

</Project>
